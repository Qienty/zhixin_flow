# Pro 层 AI 分析配置示例。复制成 .env 再填入自己的 key。
# .env 已被 .gitignore 排除，不会进仓库。
TETHER_AI_API_KEY=sk-your-key-here

# 任意 OpenAI 兼容接口都可以：DeepSeek / 通义 / Moonshot / 自建 vLLM 等
TETHER_AI_BASE_URL=https://api.deepseek.com/v1
TETHER_AI_MODEL=deepseek-flash

# 单次分析超时（秒）与输出预算（截断会自动翻倍重试一次）
TETHER_AI_TIMEOUT=60
TETHER_AI_MAX_TOKENS=4000

# 推理强度：low / high / max。兼容服务未必支持，可能直接拒绝参数；
# 当前客户端会发送 reasoning_effort，切换供应商前请核对其参数支持。
TETHER_AI_REASONING_EFFORT=high

# 备用端点（可选）：主用地址网络失败时自动切换；不填则只用上面的主用地址。
# 本地离线演示可以只配一个 Ollama 地址（Base URL 用 http://127.0.0.1:11434/v1）。
# TETHER_AI_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
# TETHER_AI_FALLBACK_MODEL=qwen3
# TETHER_AI_FALLBACK_API_KEY=

# 配好之后在「我的」页点「测试连接」，验证 key、地址与 JSON 输出能力。


# 可选：允许跨源访问的来源（逗号分隔，逐字匹配，不支持通配）。
# 同源部署（浏览器直接访问站点 / Nginx 同域反代）不需要这一项。
# 只有原生壳或独立调试前端才需要，例如：
# TETHER_ALLOWED_ORIGINS=capacitor://localhost,https://api.example.com
# 注意：http(s) 的 127.0.0.1 / localhost 默认就放行，无需列出。

# HTTP/data settings below must be set in the SERVICE PROCESS environment.
# Only AI settings above are guaranteed to be loaded from this .env file.
# TETHER_TRUSTED_PROXIES=127.0.0.1
# TETHER_DATA_DIR=/srv/tether/data
# HOST=127.0.0.1
# PORT=8000
# TETHER_DEV_PAGES=1  # development only; leave unset in production
# TETHER_HTTP_TIMEOUT=65          # socket idle/read timeout, 1–300 seconds
# TETHER_HTTP_MAX_CONNECTIONS=64  # active connection threads, 1–512
# TETHER_AI_MIN_INTERVAL=60      # per-account starts, 1–3600 seconds
# TETHER_AI_MAX_CONCURRENT=4     # active model analyses per process, 1–64
# TETHER_REGISTER_LIMIT=10       # attempts per client IP per 5 minutes, 1–100
# Limits are process-local; multiple workers require shared gateway limits.
