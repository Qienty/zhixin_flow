# Pro 层 AI 分析配置示例。复制成 .env 再填入自己的 key。
# .env 已被 .gitignore 排除，不会进仓库。
TETHER_AI_API_KEY=sk-your-key-here

# 任意 OpenAI 兼容接口都可以：DeepSeek / 通义 / Moonshot / 自建 vLLM 等
TETHER_AI_BASE_URL=https://api.deepseek.com/v1
TETHER_AI_MODEL=deepseek-flash

# 单次分析超时（秒）与输出预算（截断会自动翻倍重试一次）
TETHER_AI_TIMEOUT=60
TETHER_AI_MAX_TOKENS=4000

# 推理强度：low 更快，high 写得更好。不支持该参数的服务商会忽略它。
TETHER_AI_REASONING_EFFORT=high

# HTTP/data settings below must be set in the SERVICE PROCESS environment.
# Only AI settings above are guaranteed to be loaded from this .env file.
# TETHER_TRUSTED_PROXIES=127.0.0.1
# TETHER_DATA_DIR=/srv/tether/data
# HOST=127.0.0.1
# PORT=8000
# TETHER_DEV_PAGES=1  # development only; leave unset in production
